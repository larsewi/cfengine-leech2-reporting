{
  "name": "cfengine-leech2-reporting",
  "description": "Gives CFEngine Community users a hub-side reporting pipeline",
  "type": "module",
  "git": true,
  "provides": {
    "cfengine-leech2-reporting": {
      "description": "Gives CFEngine Community users a hub-side reporting pipeline",
      "tags": ["experimental"],
      "subdirectory": "leech2",
      "steps": [
        "copy ./leech2.cf services/cfbs/leech2.cf",
        "copy ./leech2_packages.cf services/cfbs/leech2_packages.cf",
        "copy ./leech2_db.cf services/cfbs/leech2_db.cf",
        "copy ./leech2_pgadmin.cf services/cfbs/leech2_pgadmin.cf",
        "policy_files services/cfbs/leech2.cf services/cfbs/leech2_packages.cf services/cfbs/leech2_db.cf services/cfbs/leech2_pgadmin.cf",
        "bundles leech2"
      ]
    }
  },
  "build": [
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF).",
      "tags": ["supported", "base"],
      "repo": "https://github.com/cfengine/masterfiles",
      "by": "https://github.com/cfengine",
      "version": "3.27.1",
      "commit": "15d8ca2ca951db3ddf197b90c9dea6ef75f5fa89",
      "added_by": "cfbs init",
      "steps": [
        "run EXPLICIT_VERSION=3.27.1 EXPLICIT_RELEASE=1 ./prepare.sh -y",
        "copy ./ ./"
      ]
    },
    {
      "name": "./leech2/",
      "description": "Gives CFEngine Community users a hub-side reporting pipeline",
      "added_by": "cfbs add",
      "steps": [
        "copy ./leech2.cf services/cfbs/leech2.cf",
        "copy ./leech2_packages.cf services/cfbs/leech2_packages.cf",
        "copy ./leech2_db.cf services/cfbs/leech2_db.cf",
        "copy ./leech2_pgadmin.cf services/cfbs/leech2_pgadmin.cf",
        "policy_files services/cfbs/leech2.cf services/cfbs/leech2_packages.cf services/cfbs/leech2_db.cf services/cfbs/leech2_pgadmin.cf",
        "bundles leech2"
      ]
    }
  ]
}
