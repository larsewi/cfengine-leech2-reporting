{
  "name": "cfengine-leech2-reporting",
  "description": "Gives CFEngine Community users a hub-side reporting pipeline",
  "type": "module",
  "git": true,
  "provides": {
    "cfengine-leech2-reporting": {
      "description": "Gives CFEngine Community users a hub-side reporting pipeline",
      "tags": ["experimental"],
      "subdirectory": "leech2",
      "steps": [
        "copy ./leech2.cf services/cfbs/leech2.cf",
        "copy ./postgres.cf services/cfbs/postgres.cf",
        "copy ./pgadmin.cf services/cfbs/pgadmin.cf",
        "copy ./agent.cf services/cfbs/agent.cf",
        "copy ./config.json services/cfbs/config.json",
        "policy_files services/cfbs/leech2.cf services/cfbs/postgres.cf services/cfbs/pgadmin.cf services/cfbs/agent.cf",
        "json ./def.json def.json",
        "bundles leech2_install leech2_postgres leech2_database leech2_pgadmin leech2_agent"
      ]
    }
  },
  "build": [
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF).",
      "tags": ["supported", "base"],
      "repo": "https://github.com/cfengine/masterfiles",
      "by": "https://github.com/cfengine",
      "version": "3.27.1",
      "commit": "15d8ca2ca951db3ddf197b90c9dea6ef75f5fa89",
      "added_by": "cfbs init",
      "steps": [
        "run EXPLICIT_VERSION=3.27.1 EXPLICIT_RELEASE=1 ./prepare.sh -y",
        "copy ./ ./"
      ]
    },
    {
      "name": "./leech2/",
      "description": "Gives CFEngine Community users a hub-side reporting pipeline",
      "added_by": "cfbs add",
      "steps": [
        "copy ./leech2.cf services/cfbs/leech2.cf",
        "copy ./postgres.cf services/cfbs/postgres.cf",
        "copy ./pgadmin.cf services/cfbs/pgadmin.cf",
        "copy ./agent.cf services/cfbs/agent.cf",
        "copy ./config.json services/cfbs/config.json",
        "policy_files services/cfbs/leech2.cf services/cfbs/postgres.cf services/cfbs/pgadmin.cf services/cfbs/agent.cf",
        "json ./def.json def.json",
        "bundles leech2_install leech2_postgres leech2_database leech2_pgadmin leech2_agent"
      ]
    }
  ]
}
