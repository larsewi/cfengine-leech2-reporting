body file control
{
  evaluation_order => "top_down";
}

bundle agent leech2_install
{
  vars:
    any::
      "version"  string => "5.0.0";
      "base_url" string => "https://github.com/larsewi/leech2/releases/download/v$(version)";

    debian.x86_64::
      "arch" string => "amd64";
    debian.aarch64::
      "arch" string => "arm64";
    redhat.x86_64::
      "arch" string => "x86_64";
    redhat.aarch64::
      "arch" string => "aarch64";

    debian::
      "pkg"    string => "leech2_$(version)-1_$(arch).deb";
      "method" string => "apt_get";
    redhat::
      "pkg"    string => "leech2-$(version)-1.$(arch).rpm";
      "method" string => "yum|dnf";

    (debian|redhat)::
      "pkg_version" string => "$(version)-1";
      "url"         string => "$(base_url)/$(pkg)";
      "pkg_path"    string => "/tmp/$(pkg)";
      "matches"
        data => packagesmatching("leech2", "$(pkg_version)", "$(arch)", "$(method)");

  classes:
    (debian|redhat)::
      "leech2_installed"
        expression => isgreaterthan(length("matches"), 0);

  commands:
    (debian|redhat).!leech2_installed::
      "curl -fsSL -o $(pkg_path) $(url)"
        contain => in_shell;

  packages:
    (debian|redhat).!leech2_installed::
      "$(pkg_path)"
        policy => "present";
}

bundle agent leech2_packages
{
  vars:
    policy_server::
      "pgadmin_key_path"
        string => "/usr/share/keyrings/packages-pgadmin-org.asc";
      "pgadmin_key_response"
        data => url_get("https://www.pgadmin.org/static/packages_pgadmin_org.pub", "{}");
      "pgadmin_repo_line"
        string => "deb [signed-by=$(pgadmin_key_path)] https://ftp.postgresql.org/pub/pgadmin/pgadmin4/apt/$(sys.os_release[VERSION_CODENAME]) pgadmin4 main";

  files:
    policy_server::
      "$(pgadmin_key_path)"
        create  => "true",
        content => "$(pgadmin_key_response[content])",
        perms   => mog("0644", "root", "root"),
        classes => if_repaired("pgadmin_repo_changed");

      "/etc/apt/sources.list.d/pgadmin4.list"
        create    => "true",
        edit_line => insert_lines("$(pgadmin_repo_line)"),
        perms     => mog("0644", "root", "root"),
        classes   => if_repaired("pgadmin_repo_changed");

  commands:
    policy_server.pgadmin_repo_changed::
      "$(paths.path[apt_get]) update";

  packages:
    policy_server::
      "postgresql"
        policy => "present";
      "pgadmin4-web"
        policy => "present";

  services:
    policy_server::
      "postgresql"
        service_policy => "start";

  reports:
    policy_server::
      "pgAdmin is installed but not configured. Run: sudo /usr/pgadmin4/bin/setup-web.sh"
        unless => fileexists("/var/lib/pgadmin/pgadmin4.db");
}
