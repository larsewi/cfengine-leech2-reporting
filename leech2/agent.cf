body file control
{
  evaluation_order => "top_down";
}

body action quiet
{
  report_level => "error";
  log_level    => "error";
}

bundle agent leech2_agent
{
  vars:
    any::
      "workdir"
        string => "/var/cfengine/state/leech2";
      "include_regex"
        string => join("|", "default:def.metatags_include");
      "exclude_regex"
        string => join("|", "default:def.metatags_exclude");
      "included"
        slist  => variablesmatching(".*", "$(include_regex)");
      "excluded"
        slist  => variablesmatching(".*", "$(exclude_regex)");
      "var_names"
        slist  => difference("included", "excluded");
      "tag_lists[$(var_names)]"
        slist  => getvariablemetatags("$(var_names)");
      "tags[$(var_names)]"
        string => join(";", "tag_lists[$(var_names)]");
      "escaped_name[$(var_names)]"
        string => string_replace("$(var_names)", "\"", "\"\"");
      "escaped_value[$(var_names)]"
        string => string_replace("$($(var_names))", "\"", "\"\"");
      "escaped_tags[$(var_names)]"
        string => string_replace("$(tags[$(var_names)])", "\"", "\"\"");
      "rows[$(var_names)]"
        string => "\"$(escaped_name[$(var_names)])\",\"$(escaped_value[$(var_names)])\",\"$(escaped_tags[$(var_names)])\"";
      "csv_rows"
        slist  => getvalues("rows");
      "joined"
        string => join("$(const.n)", "csv_rows");
      "csv"
        string => "\"name\",\"value\",\"tags\"$(const.n)$(joined)$(const.n)";

  files:
    any::
      "$(workdir)/."
        create => "true";

      "$(workdir)/vars.csv"
        create  => "true",
        content => "$(csv)",
        action  => quiet;
}
